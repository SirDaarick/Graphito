# ==============================================================================
# GRAPHITO - Vercel + ngrok + Supabase deployment (docker-compose.vercel.yml)
#   cp .env.vercel.example .env.vercel     (never commit .env.vercel)
# ==============================================================================

# ------------------------------------------------------------------------------
# ngrok (read by docker compose; backend never sees them)
# ------------------------------------------------------------------------------
# Authtoken: https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=replace_with_your_ngrok_authtoken
# Your free static domain, WITHOUT https:// (ngrok dashboard > Domains).
NGROK_DOMAIN=your-name.ngrok-free.app

# ------------------------------------------------------------------------------
# Backend
# ------------------------------------------------------------------------------
APP_ENV=production
DEMO_MODE=false
INFERENCE_MODE=REAL
ALLOW_UNCALIBRATED=false
GCB_SECONDARY_ENABLED=true
INFERENCE_WORKERS=1

# openssl rand -hex 32   (minimum 32 characters)
JWT_SECRET=replace_with_a_secure_random_jwt_secret_key_minimum_32_characters

# Optional: only if the frontend uses Google sign-in.
GOOGLE_CLIENT_ID=

# JSON list. https://*.vercel.app previews are already allowed by the backend; add your
# production domain (and a custom domain if you have one).
CORS_ORIGINS=["https://your-project.vercel.app"]

# ------------------------------------------------------------------------------
# Supabase (Project Settings > Database > Connection string > Session pooler)
# ------------------------------------------------------------------------------
# Use the SESSION pooler (port 5432). The direct host (db.<ref>.supabase.co) is IPv6-only and
# does not resolve from most Docker/Windows setups. URL-encode special characters in the password.
DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<url-encoded-password>@aws-0-<region>.pooler.supabase.com:5432/postgres?ssl=require
# Set to true ONLY if you switch to the transaction pooler (port 6543).
DB_POOLER_COMPAT=false
