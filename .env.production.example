# ==============================================================================
# GRAPHITO — PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env.production before running Docker Compose in production:
#   cp .env.production.example .env.production
# Ensure to replace all placeholder secrets with strong, unique credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# Application Environment & Runtime Modes
# ------------------------------------------------------------------------------
# In production, APP_ENV must be set to 'production' to enforce strict security
# and calibration validation checks (refuses development-only switches).
APP_ENV=production

# Standalone demo mode disabled for production (backend & database are active).
DEMO_MODE=false

# ------------------------------------------------------------------------------
# Security & Authentication
# ------------------------------------------------------------------------------
# Secret key used for signing JWT tokens.
# REQUIRED: Replace with a cryptographically secure random string (minimum 32 characters).
JWT_SECRET=replace_with_a_secure_random_jwt_secret_key_minimum_32_characters

# ------------------------------------------------------------------------------
# PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
# Credentials used by the PostgreSQL container and backend migrations/sessions.
POSTGRES_USER=graphito
POSTGRES_PASSWORD=replace_with_a_strong_database_password
POSTGRES_DB=graphito_db

# Async SQLAlchemy database URL used by the backend.
# Host is 'postgres' matching the docker compose service name within graphito-net.
DATABASE_URL=postgresql+asyncpg://graphito:replace_with_a_strong_database_password@postgres:5432/graphito_db

# ------------------------------------------------------------------------------
# ChromaDB Vector Store Configuration
# ------------------------------------------------------------------------------
# Connect to the dedicated ChromaDB service container.
USE_CHROMA_SERVER=true
CHROMA_HOST=chroma
CHROMA_PORT=8000

# ------------------------------------------------------------------------------
# Inference & Machine Learning Configuration
# ------------------------------------------------------------------------------
# Real model inference mode ('REAL' executes full lexical & deep learning pipelines).
INFERENCE_MODE=REAL

# ALLOW_UNCALIBRATED must remain false in production.
# Scoring requests will fail-closed if calibrations or model checkpoints are missing.
ALLOW_UNCALIBRATED=false

# Secondary exploratory signal using GraphCodeBERT v2 (true keeps REAL blocked until loaded).
GCB_SECONDARY_ENABLED=true

# Number of uvicorn worker processes for inference handling.
INFERENCE_WORKERS=2

# Deploy artifacts manifest and model calibration paths
DEPLOY_MANIFEST=models/deploy/manifest.json
CHANNEL_A_CALIBRATION=models/deploy/channel_a/calibration.json
CHANNEL_A_THRESHOLD_KEY=fpr_0.05
CHARCNN_CHECKPOINT=models/deploy/channel_b/best.pth
CHARCNN_CALIBRATION=models/deploy/channel_b/calibration.json
CHARCNN_THRESHOLD_KEY=fpr_0.01
