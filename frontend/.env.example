# URL del Backend de Graphito (Solo requerida si DEMO_MODE=false)
VITE_API_URL=http://localhost:8000/api/v1

# Modo Demostración Standalone (true = Sin backend ni BD, datos precargados locales en memoria)
DEMO_MODE=true
VITE_DEMO_MODE=true

# Credencial de Google OAuth 2.0 (Google Identity Services)
# Obtén tu Client ID desde: https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_CLIENT_ID=
