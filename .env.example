# ============================================================
# GRAPHITO — CONFIGURACIÓN DE VARIABLES DE ENTORNO
# Copia este archivo como .env:
# Windows (PowerShell): Copy-Item .env.example .env
# Windows (CMD):       copy .env.example .env
# Linux / macOS:       cp .env.example .env
# ============================================================

# LLM API Keys (Opcional, para generación de referencias en /data)
GOOGLE_API_KEY=tu_api_key_aqui
# OPENCODE_API_KEY=
# OPENROUTER_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434

# ============================================================
# BACKEND RUNTIME CONFIG
# ============================================================
INFERENCE_MODE=REAL
USE_CHROMA_SERVER=true
CHROMA_HOST=localhost
CHROMA_PORT=8001
DATABASE_URL=postgresql+asyncpg://graphito:graphitosecret@localhost:5432/graphito_db
